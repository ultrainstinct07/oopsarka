# OopsArka environment variables.
#
# Copy to .env.local for development. In Vercel, set the same names under
# Settings → Environment Variables (see docs/DEPLOYMENT.md for which ones
# belong in Production vs Preview), then redeploy.
#
# Everything is optional. With nothing set, the site runs on the local sample
# content and both forms say plainly that they aren't connected yet.
# Never give a secret a NEXT_PUBLIC_ name: those are sent to the browser.

# ── Site ──────────────────────────────────────────────────────────────
# Canonical origin. Defaults to https://oopsarka.space. Leave it unset in Vercel,
# so preview URLs never end up in canonicals, the sitemap or feeds.
# NEXT_PUBLIC_SITE_URL=https://oopsarka.space

# ── Sanity CMS (docs/SANITY.md) ──────────────────────────────────────
# Setting the project ID switches the site from local sample content to Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Viewer token for draft previews (Presentation tool). Server only.
SANITY_API_READ_TOKEN=
# Shared secret for the publish webhook → /api/revalidate. Server only.
SANITY_REVALIDATE_SECRET=

# ── Newsletter: Buttondown (docs/INTEGRATIONS.md) ───────────────────
# Without it, production shows "opens soon" and collects no addresses.
BUTTONDOWN_API_KEY=

# ── Contact form: Resend ──────────────────────────────────────────────
RESEND_API_KEY=
# Your inbox, where messages are delivered.
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "OopsArka <hello@oopsarka.space>".
CONTACT_FROM_EMAIL=

# ── Abuse protection (optional) ───────────────────────────────────────
# Upstash Redis: one rate limit shared by all serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for the hashed rate-limit key (raw IPs are never stored). Any long random string.
RATE_LIMIT_SALT=
# Cloudflare Turnstile on the contact form. Set both or neither, and Production only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional) ──────────────────────────────────────────────
# "1" renders Vercel Web Analytics (cookieless) and names it in /privacy.
# Enable Analytics for the project in the Vercel dashboard as well.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# ── Tooling only ──────────────────────────────────────────────────────
# FFMPEG_PATH=/path/to/ffmpeg          # npm run media (defaults to ffmpeg on PATH)
# E2E_BASE_URL=https://oopsarka.space  # npm run test:e2e against a deployed site
