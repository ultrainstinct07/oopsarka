{
  "name": "oopsarka",
  "version": "1.0.0",
  "private": true,
  "description": "OopsArka.space — the wonderfully chaotic life of Arka, a Persian cat.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typegen": "sanity schema extract --path=./sanity/extract.json && sanity typegen generate",
    "cn": "cn build --css src/app/globals.css --content \"src/**/*.{ts,tsx}\" -o src/lib/cn-tables.ts",
    "seed": "sanity exec scripts/seed-sanity.ts --with-user-token",
    "media": "node scripts/process-media.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@react-three/fiber": "9.8.2",
    "@sanity/icons": "5.2.3",
    "@sanity/image-url": "2.1.1",
    "@sanity/vision": "5.31.2",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.56.0",
    "minisearch": "7.2.0",
    "motion": "14.3.0",
    "next": "16.4.3",
    "next-sanity": "13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.33.0",
    "sanity": "5.31.2",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "styled-components": "6.6.0",
    "tailwind-merge": "3.7.0",
    "three": "0.182.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
